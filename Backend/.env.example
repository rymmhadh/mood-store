# Copier en `.env` avant le premier démarrage.

PORT=4000

# Le port 5433 côté hôte évite le conflit avec un PostgreSQL déjà installé.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=moodstore
DATABASE_PASSWORD=moodstore
DATABASE_NAME=moodstore

# Sur Vercel : une base hébergée (Neon via le Marketplace Vercel, par
# exemple) fournit une chaîne de connexion plutôt que des champs séparés.
# Vercel l'ajoute lui-même à l'environnement du projet une fois la base
# connectée (Storage → Create Database → Postgres) sous le nom DATABASE_URL
# ou POSTGRES_URL selon le fournisseur — les deux noms sont lus. Laissez
# cette ligne vide/absente en local : DATABASE_HOST et les champs voisins
# ci-dessus continuent de s'appliquer.
# DATABASE_URL=

# Origines autorisées à appeler l'API (le front en développement). En
# production, l'URL du site Vercel (ex. https://mood-store-web.vercel.app,
# puis le domaine définitif une fois branché).
ORIGINES_AUTORISEES=http://localhost:3000

# Racine publique des médias. Doit correspondre à ce que le front autorise
# dans `next.config.ts` → images.remotePatterns. Sans effet dès qu'une
# photo est stockée dans Vercel Blob : son URL est déjà complète.
URL_PUBLIQUE=http://localhost:4000

# Stockage des photographies téléversées. En local, laissez vide : les
# fichiers vont sur le disque (dossier media/). Sur Vercel — dont le
# système de fichiers ne conserve rien d'une requête à l'autre — Vercel
# ajoute lui-même cette variable une fois un store Blob connecté au projet
# (Storage → Create Database → Blob). Sans elle, tout téléversement échoue
# une fois déployé.
# BLOB_READ_WRITE_TOKEN=

# Synchronisation automatique du schéma. Pratique en développement,
# à passer à `false` dès qu'il y a des données à ne pas perdre.
SYNCHRONISER_SCHEMA=true

# Amorçage du catalogue au démarrage si la base est vide.
AMORCER_SI_VIDE=true
